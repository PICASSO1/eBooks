 *    <string>: 要被轉換的「字串」
 * 
(*)?*/

strTemp = "\0"
nTemp = 0

int2str strTemp 123456
messagebox strTemp "int2str: "

str2int nTemp "789012"
messagebox nTemp "str2int: "

exit
