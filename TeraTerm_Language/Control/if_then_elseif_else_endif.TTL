IDX = 2

if IDX = 0 then
	sendln "###### IDX = 0 ###### "
elseif IDX = 1 then
	sendln "###### IDX = 1 ###### "
elseif IDX = 2 then
	
elseif IDX = 3 then
	sendln "###### IDX = 3 ###### "
else
	sendln "###### IDX = ? ###### "
endif

pause 1

exit
