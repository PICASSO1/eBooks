(*)?*/

IDX = 0

sendln "echo 'do - condition, loop: '"

do while IDX < 10
	sendln "echo 'Hello!! World!!'"
	sendln ""
	pause 1
	IDX = IDX + 1
loop

sendln "echo 'do, loop - condition: '"

do
	sendln "echo 'World!! Hello!! '"
	sendln ""
	pause 1
	IDX = IDX - 1
loop while IDX > 0

exit
